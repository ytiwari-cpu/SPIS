FAMILY_OUTBOX_POLL_MS=3000
FAMILY_OUTBOX_BATCH_SIZE=50

# ─────────────────────────────────────────────────────────────────────────────
# IAM SERVICE (Port 3003)
# ─────────────────────────────────────────────────────────────────────────────

IAM_SERVICE_PORT=3003

# PostgreSQL (auth_db)
IAM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db
IAM_DB_POOL_MIN=2
IAM_DB_POOL_MAX=10

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL SERVICE (Port 3002)
# ─────────────────────────────────────────────────────────────────────────────

EMAIL_SERVICE_PORT=3002

# PostgreSQL (email_db)
EMAIL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_db
EMAIL_DB_POOL_MIN=2
EMAIL_DB_POOL_MAX=10

# SendGrid (Primary Email Provider)
SENDGRID_API_KEY=SG.your-api-key-here
SENDGRID_FROM_EMAIL=noreply@spis.gov.jm
SENDGRID_FROM_NAME=SPIS Jamaica

# SMTP Fallback
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASS=smtp-password

# Email Templates
EMAIL_TEMPLATE_DIR=./templates
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=5000
