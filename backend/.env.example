# ══════════════════════════════════════════════════════════════════════════════
# SPIS Backend — Shared Environment Configuration
# All backend services read from this file
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# SHARED SERVICES
# ─────────────────────────────────────────────────────────────────────────────

# RabbitMQ (Message Bus)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=spis.events
RABBITMQ_PREFETCH=5

# Keycloak (Authentication)
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=spis-dev
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Frontend Client
KEYCLOAK_FRONTEND_CLIENT_ID=frontend
KEYCLOAK_FRONTEND_CLIENT_SECRET=

# Redis (Caching & Sessions)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=spis:

# Common
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# FAMILY SERVICE (Port 3001)
# ─────────────────────────────────────────────────────────────────────────────

FAMILY_SERVICE_PORT=3001

