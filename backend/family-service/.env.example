# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# JWT Secret (for token validation)
JWT_SECRET=your-jwt-secret

# Keycloak (for national ID + password login)
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=spis-dev
KEYCLOAK_FRONTEND_CLIENT_ID=frontend
KEYCLOAK_FRONTEND_CLIENT_SECRET=

# RabbitMQ (Outbox -> IAM bridge)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=spis.events
OUTBOX_BRIDGE_POLL_MS=3000
OUTBOX_BRIDGE_BATCH_SIZE=50
