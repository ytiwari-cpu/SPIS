# ══════════════════════════════════════════════════════════
# SPIS Family Service — Environment Variables
# ══════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── PostgreSQL ────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/spis_family

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── JWT (verify tokens issued by IAM) ────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_ISSUER=spis-iam
JWT_AUDIENCE=spis

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Request Timeout (Phase 0.25) ─────────────────────────
REQUEST_TIMEOUT_MS=30000

# ── IAM Service ──────────────────────────────────────────
IAM_SERVICE_URL=http://localhost:3003

# ── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=spis.events

# ── Outbox Bridge ────────────────────────────────────────
OUTBOX_BRIDGE_POLL_MS=5000
OUTBOX_BRIDGE_BATCH_SIZE=50
