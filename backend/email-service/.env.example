# ═══════════════════════════════════════════════════════════════
# SPIS Email Service — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── PostgreSQL (email_db) ───────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=spis.events
RABBITMQ_PREFETCH=5

# ── SendGrid (primary provider) ────────────────────────────
SENDGRID_API_KEY=SG.your-api-key-here
SENDGRID_FROM_EMAIL=noreply@spis.gov.jm
SENDGRID_FROM_NAME=SPIS Jamaica

# ── SMTP Fallback ──────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
SMTP_FROM_EMAIL=noreply@spis.gov.jm
SMTP_FROM_NAME=SPIS Jamaica

# ── Rate Limits ────────────────────────────────────────────
RATE_LIMIT_OTP_PER_EMAIL_PER_HOUR=5
RATE_LIMIT_INVITE_PER_EMAIL_PER_DAY=3
RATE_LIMIT_GLOBAL_PER_DAY=100

# ── Retry / Circuit Breaker ───────────────────────────────
MAX_SEND_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=60000

# ── Data Retention ─────────────────────────────────────────
PAYLOAD_RETENTION_DAYS=30

# ── Webhook Signing ───────────────────────────────────────
SENDGRID_WEBHOOK_VERIFICATION_KEY=your-webhook-verification-key

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=debug
