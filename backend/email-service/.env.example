# ══════════════════════════════════════════════════════════
# SPIS Email Service — Environment Variables
# ══════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3002

# ── PostgreSQL ────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/spis_email
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Inter-service Auth (Phase 0.25) ──────────────────────
SERVICE_AUTH_KEY=

# ── Request Timeout (Phase 0.25) ─────────────────────────
REQUEST_TIMEOUT_MS=30000

# ── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=spis.events
RABBITMQ_PREFETCH=10

# ── SMTP ──────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SPIS
SMTP_FROM_EMAIL=noreply@spis.gov

# ── SendGrid ─────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_NAME=SPIS
SENDGRID_FROM_EMAIL=noreply@spis.gov
SENDGRID_WEBHOOK_VERIFICATION_KEY=

# ── Rate Limits ───────────────────────────────────────────
RATE_LIMIT_OTP_PER_EMAIL_PER_HOUR=5
RATE_LIMIT_INVITE_PER_EMAIL_PER_DAY=3
RATE_LIMIT_GLOBAL_PER_DAY=10000

# ── Retry / Circuit Breaker ──────────────────────────────
RETRY_BASE_DELAY_MS=1000
MAX_SEND_ATTEMPTS=3
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=60000

# ── Payload Retention ────────────────────────────────────
PAYLOAD_RETENTION_DAYS=30
