# ══════════════════════════════════════════════════════════
# SPIS IAM Service — Environment Variables
# ══════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3003

# ── PostgreSQL ────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/spis_iam
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_ISSUER=spis-iam
JWT_AUDIENCE=spis
JWT_EXPIRES_IN=3600

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=iam:

# ── OTP / Password Reset ─────────────────────────────────
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
PASSWORD_MIN_LENGTH=8

# ── Account Lockout ──────────────────────────────────────
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15

# ── TOTP MFA ──────────────────────────────────────────────
TOTP_ISSUER=SPIS
TOTP_ALGORITHM=SHA1
TOTP_DIGITS=6
TOTP_PERIOD=30

# ── MFA Encryption (Phase 0.25) ──────────────────────────
# 64-char hex string = 32 bytes AES-256 key
MFA_ENCRYPTION_KEY=

# ── Email Service ─────────────────────────────────────────
EMAIL_SERVICE_URL=http://localhost:3002

# ── Inter-service Auth (Phase 0.25) ──────────────────────
SERVICE_AUTH_KEY=

# ── Worker Registration (Phase 0.25) ─────────────────────
WORKER_REGISTRATION_SECRET=

# ── Request Timeout (Phase 0.25) ─────────────────────────
REQUEST_TIMEOUT_MS=30000

# ── Keycloak ──────────────────────────────────────────────
KEYCLOAK_REALM=spis
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_BACKEND_CLIENT_ID=spis-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=
KEYCLOAK_FRONTEND_CLIENT_ID=spis-frontend

# ── JWKS / Gateway ───────────────────────────────────────
JWKS_URL=http://localhost:8080/realms/spis/protocol/openid-connect/certs
JWKS_CACHE_TTL_SECONDS=3600

# ── Registry Service ──────────────────────────────────────
REGISTRY_SERVICE_URL=http://localhost:3001

# ── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=spis.events
RABBITMQ_PREFETCH=10
