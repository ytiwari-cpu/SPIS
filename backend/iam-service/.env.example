# ══════════════════════════════════════════════════════════
# SPIS IAM Service — Environment Variables
# ══════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────
PORT=3003
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── PostgreSQL (auth_db) ─────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=spis:iam:

# ── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=spis.events
RABBITMQ_PREFETCH=5

# ── Keycloak ──────────────────────────────────────────────
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=spis-dev
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_FRONTEND_CLIENT_ID=frontend
KEYCLOAK_BACKEND_CLIENT_ID=backend
KEYCLOAK_BACKEND_CLIENT_SECRET=

# ── Email Service ─────────────────────────────────────────
EMAIL_SERVICE_URL=http://localhost:3002

# ── Registry Service ──────────────────────────────────────
REGISTRY_SERVICE_URL=http://localhost:3001

# ── OTP / Password Reset ─────────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
PASSWORD_MIN_LENGTH=12

# ── Account Lockout ──────────────────────────────────────
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15

# ── TOTP ──────────────────────────────────────────────────
TOTP_ISSUER=SPIS Jamaica
TOTP_ALGORITHM=SHA1
TOTP_DIGITS=6
TOTP_PERIOD=30

# ── JWKS / Gateway ───────────────────────────────────────
JWKS_CACHE_TTL_SECONDS=900
JWKS_URL=http://localhost:8080/realms/spis-dev/protocol/openid-connect/certs

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=debug
