# ══════════════════════════════════════════════════════════
# SPIS Programme Service — Environment Variables
# ══════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PROGRAMME_SERVICE_PORT=3004

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Request Timeout (Phase 0.25) ─────────────────────────
REQUEST_TIMEOUT_MS=30000

# ── Supabase (Programme) ─────────────────────────────────
PROGRAMME_SUPABASE_URL=https://your-project.supabase.co
PROGRAMME_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Supabase (Family — cross-service reads) ──────────────
FAMILY_SUPABASE_URL=https://your-family-project.supabase.co
FAMILY_SUPABASE_SERVICE_ROLE_KEY=your-family-service-role-key

# ── Family DB (direct pg connection for batch rule engine) ─
# FAMILY_DATABASE_URL=postgresql://user:pass@host:5432/family_db

# ── IAM Service ──────────────────────────────────────────
IAM_SERVICE_URL=http://localhost:3003

# ── JWT (verify tokens issued by IAM) ────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_ISSUER=spis-iam
JWT_AUDIENCE=spis
