import { useState } from 'react'
import type { DocumentType, DocumentStatus } from '@/types'

interface DocumentItem {
  id: string
  document_type: DocumentType
  file_name: string
  programme_name: string
  status: DocumentStatus
  rejection_reason?: string
  uploaded_at: string
}

const mockDocuments: DocumentItem[] = [
  {
    id: 'doc_001',
    document_type: 'NATIONAL_ID',
    file_name: 'national_id_card.pdf',
    programme_name: 'Education Scholarship 2026',
    status: 'VERIFIED',
    uploaded_at: '2026-01-12T10:00:00Z',
  },
  {
    id: 'doc_002',
    document_type: 'INCOME_STATEMENT',
    file_name: 'income_statement_2025.pdf',
    programme_name: 'Housing Assistance Grant',
    status: 'PENDING',
    uploaded_at: '2026-02-01T14:30:00Z',
  },
  {
    id: 'doc_003',
    document_type: 'PROOF_OF_ADDRESS',
    file_name: 'address_proof.jpg',
    programme_name: 'Education Scholarship 2026',
    status: 'REJECTED',
    rejection_reason: 'The document is blurry and unreadable.',
    uploaded_at: '2026-01-10T09:00:00Z',
  },
]

const documentTypeLabels: Record<DocumentType, string> = {
  NATIONAL_ID: 'National Identity Card',
  BIRTH_CERTIFICATE: 'Birth Certificate',
  PROOF_OF_ADDRESS: 'Proof of Address',
  INCOME_STATEMENT: 'Income Statement',
  MARRIAGE_CERTIFICATE: 'Marriage Certificate',
  DEATH_CERTIFICATE: 'Death Certificate',
  OTHER: 'Other Document',
}

const getStatusBadge = (status: DocumentStatus) => {
  const styles = {
    VERIFIED: 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400',
    PENDING: 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400',
    REJECTED: 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400',
  }
  return styles[status]
}

export default function Documents() {
  const [documents] = useState<DocumentItem[]>(mockDocuments)
  const [selectedProgramme, setSelectedProgramme] = useState('')
  const [selectedDocType, setSelectedDocType] = useState('')

  return (
    <div className="p-4 md:p-8">
      <div className="max-w-3xl mx-auto">
        {/* Header */}
        <header className="flex items-center justify-between mb-6">
          <h1 className="text-2xl font-bold text-gray-900 dark:text-white">Documents</h1>
        </header>

        {/* Upload Section */}
        <section className="mb-8">
          <h2 className="text-lg font-bold text-gray-900 dark:text-white mb-4">Upload Document</h2>
          <div className="bg-white dark:bg-gray-900 rounded-xl p-5 border border-gray-200 dark:border-gray-800 shadow-sm">
            <div className="space-y-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  Programme
                </label>
                <select
                  value={selectedProgramme}
                  onChange={(e) => setSelectedProgramme(e.target.value)}
                  className="w-full h-12 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 focus:ring-2 focus:ring-primary outline-none text-sm text-gray-900 dark:text-white"
                >
                  <option value="">Select Programme</option>
                  <option value="education">Education Scholarship 2026</option>
                  <option value="housing">Housing Assistance Grant</option>
                  <option value="health">Healthcare Subsidy</option>
                </select>
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  Document Type
                </label>
                <select
                  value={selectedDocType}
                  onChange={(e) => setSelectedDocType(e.target.value)}
                  className="w-full h-12 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 focus:ring-2 focus:ring-primary outline-none text-sm text-gray-900 dark:text-white"
                >
                  <option value="">Select Document Type</option>
                  <option value="NATIONAL_ID">National Identity Card</option>
                  <option value="PROOF_OF_ADDRESS">Proof of Address</option>
                  <option value="INCOME_STATEMENT">Income Statement</option>
                  <option value="BIRTH_CERTIFICATE">Birth Certificate</option>
                </select>
              </div>

              {/* File Upload Zone */}
              <div className="border-2 border-dashed border-gray-300 dark:border-gray-700 rounded-xl p-8 flex flex-col items-center justify-center text-center bg-gray-50 dark:bg-gray-800/50 cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                <span className="material-symbols-outlined text-gray-400 text-4xl mb-2">cloud_upload</span>
                <p className="text-sm text-gray-600 dark:text-gray-400 mb-1 font-medium">
                  Click to upload or drag and drop
                </p>
                <p className="text-xs text-gray-500 dark:text-gray-500">PDF, JPG or PNG (max. 5MB)</p>
                <input type="file" className="hidden" accept=".pdf,.jpg,.jpeg,.png" />
              </div>

              <button className="w-full bg-primary text-white font-bold h-12 rounded-lg hover:bg-primary-dark transition-colors flex items-center justify-center gap-2">
                <span className="material-symbols-outlined text-lg">upload</span>
                Upload Document
              </button>
            </div>
          </div>
        </section>

        {/* Document Status Section */}
        <section>
          <div className="flex items-center justify-between mb-4">
            <h2 className="text-lg font-bold text-gray-900 dark:text-white">Document Status</h2>
            <span className="text-xs font-medium text-gray-500 bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">
              {documents.length} total
            </span>
          </div>

          <div className="space-y-3">
            {documents.map((doc) => (
              <div
                key={doc.id}
                className="bg-white dark:bg-gray-900 p-4 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm"
              >
                <div className="flex justify-between items-start mb-2">
                  <div>
                    <h3 className="font-bold text-gray-900 dark:text-white">
                      {documentTypeLabels[doc.document_type]}
                    </h3>
                    <p className="text-xs text-gray-500 dark:text-gray-400">{doc.programme_name}</p>
                  </div>
                  <span className={`text-xs font-bold px-2 py-1 rounded-full uppercase tracking-wider ${getStatusBadge(doc.status)}`}>
                    {doc.status}
                  </span>
                </div>

                {doc.status === 'REJECTED' && doc.rejection_reason && (
                  <div className="mt-2 text-xs text-red-600 dark:text-red-400 italic flex items-start gap-1">
                    <span className="material-symbols-outlined text-sm">error</span>
                    "{doc.rejection_reason}"
                  </div>
                )}

                <div className="flex items-center justify-between mt-4 pt-3 border-t border-gray-100 dark:border-gray-800">
                  <span className="text-xs text-gray-400">
                    {new Date(doc.uploaded_at).toLocaleDateString('en-US', {
                      month: 'short',
                      day: 'numeric',
                      year: 'numeric',
                    })}
                  </span>
                  <div className="flex gap-4">
                    <button className="text-primary text-sm font-semibold flex items-center gap-1 hover:underline">
                      <span className="material-symbols-outlined text-sm">visibility</span>
                      View
                    </button>
                    {doc.status === 'VERIFIED' && (
                      <button className="text-primary text-sm font-semibold flex items-center gap-1 hover:underline">
                        <span className="material-symbols-outlined text-sm">download</span>
                        Download
                      </button>
                    )}
                    {doc.status === 'REJECTED' && (
                      <button className="text-primary text-sm font-semibold flex items-center gap-1 hover:underline">
                        <span className="material-symbols-outlined text-sm">edit</span>
                        Re-upload
                      </button>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  )
}
